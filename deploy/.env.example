# LICET CSE ERP: on-premise settings.
# Copy to deploy/.env (chmod 600) and fill in. deploy/.env is git-ignored;
# never commit it. Used by docker-compose.app.yml and every script in deploy/.
# Plain KEY=value lines only; quote values that contain spaces.

# ---- Domains (from the college IT team; DNS A records must point at this server)
# The ERP that people open in the browser.
APP_DOMAIN=erp.example.ac.in
# The Supabase API (auth, database API, file storage). Set it equal to
# APP_DOMAIN and CADDYFILE=Caddyfile.single-domain if only one name is given.
API_DOMAIN=erp-api.example.ac.in
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=it-admin@example.ac.in
# Caddyfile (two hostnames) or Caddyfile.single-domain (one hostname).
CADDYFILE=Caddyfile

# ---- Supabase (deploy/supabase/setup.sh fills these in from the Supabase .env)
NEXT_PUBLIC_SUPABASE_URL=https://erp-api.example.ac.in
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security: keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (optional): absence alerts, leave and grievance updates via resend.com
RESEND_API_KEY=
EMAIL_FROM="LICET CSE ERP <erp@your-verified-domain>"

# ---- Cron: shared secret sent as the x-cron-secret header to /api/cron/*
# (weekly attendance alerts). setup.sh generates one; or: openssl rand -hex 32
CRON_SECRET=

# ---- Paths on the server
# Where deploy/supabase/setup.sh installs self-hosted Supabase.
SUPABASE_DIR=/opt/licet/supabase
# Compose network of the Supabase project (project name "supabase" + "_default").
SUPABASE_NETWORK=supabase_default
SUPABASE_DB_CONTAINER=supabase-db

# ---- Backups (deploy/scripts/backup.sh)
BACKUP_DIR=/var/backups/licet-erp
KEEP_DAILY=14
KEEP_WEEKLY=8
# Day of week (1 = Monday ... 7 = Sunday) whose backup is also kept as a weekly.
WEEKLY_DAY=7
# Optional off-site copy (set one or both). Use an encrypted destination: the
# backups contain personal data, password hashes and the server's secrets.
# rsync target, e.g. backup@nas.licet.local:/volume1/erp-backups
OFFSITE_RSYNC_TARGET=
# rclone remote:path, e.g. gdrive-crypt:licet-erp (configure with `rclone config`)
OFFSITE_RCLONE_REMOTE=

# ---- Monitoring (deploy/scripts/healthcheck.sh)
DISK_WARN_PERCENT=85
BACKUP_MAX_AGE_HOURS=26
CERT_WARN_DAYS=14

TZ=Asia/Kolkata

# LICET AI assistant (optional): https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
