# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by the admin actions (add/delete students, reset passwords),
# the email API and the scripts in /scripts. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — email notifications (absence alerts, leave and grievance updates) via resend.com
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
EMAIL_FROM=LICET CSE ERP <erp@your-verified-domain>
